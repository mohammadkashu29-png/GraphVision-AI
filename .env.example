# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# OpenAI API key for Vision OCR (required for OpenAI HTR path)
OPENAI_API_KEY=sk-...

# OpenAI model to use for vision-based handwriting OCR
# Must support image input (e.g. gpt-4o, gpt-4-turbo)
OPENAI_HTR_MODEL=gpt-4o
